/* components/custom-tabbar/custom-tabbar.wxss */
.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  border-top: 2rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 1000;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: all 0.3s ease;
  position: relative;
}

.tabbar-item.active {
  background: linear-gradient(180deg, rgba(252, 201, 110, 0.1) 0%, transparent 100%);
}

.tabbar-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #666666;
  transition: all 0.3s ease;
  line-height: 1.2;
}

.tabbar-item.active .tabbar-text {
  color: #FCC96E;
  font-weight: 600;
  transform: scale(1.05);
}

/* 点击效果 */
.tabbar-item:active {
  transform: scale(0.95);
}

.tabbar-item:active .tabbar-text {
  transform: scale(0.95);
}
