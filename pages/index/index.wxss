/* pages/index/index.wxss */
.container {
  padding: 0;
  min-height: 100vh;
  background: #FFF2DF;
  /* 为底部导航栏留出空间 */
  padding-bottom: 120rpx;
}

/* 头部区域 */
.header {
  background: linear-gradient(135deg, #FCC96E 0%, #FDD89A 100%);
  padding: 40rpx 40rpx 60rpx;
  color: #156D57;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
}

.logo-title {
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #156D57;
}

.logo-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  color: #156D57;
}

.search-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(21, 109, 87, 0.2);
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #156D57;
}

/* 统计卡片 */
.stats-card {
  background: rgba(21, 109, 87, 0.2);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid rgba(21, 109, 87, 0.3);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #156D57;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(21, 109, 87, 0.8);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(21, 109, 87, 0.3);
}

/* 快捷操作区 */
.quick-actions {
  padding: 40rpx;
  background: #FFF2DF;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #020100;
  margin-bottom: 32rpx;
  display: block;
}

.quick-actions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.quick-action-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.quick-action-item:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.quick-action-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FCC96E, #FDD89A);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  font-size: 40rpx;
  color: #156D57;
}

.quick-action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #020100;
  margin-bottom: 8rpx;
}

.quick-action-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

/* 卡片列表区域 */
.cards-section {
  padding: 40rpx;
  background: #FFF2DF;
}

.cards-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.cards-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #020100;
}

.filter-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.filter-tab {
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: #FCC96E;
  color: #156D57;
  font-weight: 600;
}

.cards-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.card-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.card-info {
  flex: 1;
}

.card-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #020100;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.card-merchant {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.card-category {
  display: inline-block;
  background: rgba(252, 201, 110, 0.1);
  color: #FCC96E;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.card-progress {
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FCC96E, #FDD89A);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666666;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.3s ease;
}

.btn-primary {
  background: #FCC96E;
  color: #156D57;
}

.btn-primary:active {
  background: #E6B85A;
  transform: scale(0.95);
}

.btn-secondary {
  background: rgba(252, 201, 110, 0.1);
  color: #FCC96E;
  border: 2rpx solid rgba(252, 201, 110, 0.3);
}

.btn-secondary:active {
  background: rgba(252, 201, 110, 0.2);
  transform: scale(0.95);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(252, 201, 110, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  font-size: 60rpx;
  color: #FCC96E;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #020100;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.add-first-card-btn {
  background: #FCC96E;
  color: #156D57;
  padding: 24rpx 48rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(252, 201, 110, 0.3);
  transition: all 0.3s ease;
}

.add-first-card-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(252, 201, 110, 0.4);
}

/* 浮动添加按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #FCC96E, #FDD89A);
  border-radius: 50%;
  color: #156D57;
  font-size: 60rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(252, 201, 110, 0.4);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.fab:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 12rpx rgba(252, 201, 110, 0.6);
}
