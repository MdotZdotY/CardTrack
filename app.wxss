/* app.wxss - 全局样式 */

/* 品牌色彩系统 */
page {
  background-color: #FFFBF0;
  color: #020100;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 主色调 */
.primary-color {
  color: #FF8A00;
}

.primary-bg {
  background-color: #FF8A00;
}

.primary-gradient {
  background: linear-gradient(135deg, #FF8A00 0%, #FFB366 100%);
}

/* 辅色 */
.secondary-color {
  color: #FFFBF0;
}

.secondary-bg {
  background-color: #FFFBF0;
}

/* 文字色 */
.text-primary {
  color: #020100;
}

.text-secondary {
  color: #666666;
}

.text-light {
  color: #999999;
}

/* 警示色 */
.warning-color {
  color: #FF4444;
}

.warning-bg {
  background-color: #FF4444;
}

/* 字体大小系统 */
.text-xs {
  font-size: 22rpx;
}

.text-sm {
  font-size: 24rpx;
}

.text-base {
  font-size: 28rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.text-2xl {
  font-size: 48rpx;
}

/* 间距系统 */
.space-xs {
  margin: 8rpx;
}

.space-sm {
  margin: 16rpx;
}

.space-md {
  margin: 32rpx;
}

.space-lg {
  margin: 40rpx;
}

.space-xl {
  margin: 48rpx;
}

/* 通用按钮样式 */
.btn {
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  padding: 20rpx 32rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #FF8A00 0%, #FFB366 100%);
  color: #FFFBF0;
}

.btn-secondary {
  background: rgba(255, 138, 0, 0.1);
  color: #FF8A00;
  border: 2rpx solid rgba(255, 138, 0, 0.2);
}

.btn-warning {
  background: #FF4444;
  color: #FFFBF0;
}

/* 卡片样式 */
.card {
  background: rgba(255, 251, 240, 0.8);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 138, 0, 0.08);
  border: 2rpx solid rgba(255, 138, 0, 0.1);
}

.card-warning {
  border-left: 8rpx solid #FF4444;
  background: linear-gradient(90deg, #FFF0F0 0%, rgba(255, 251, 240, 0.9) 20%);
}

/* 进度条样式 */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 138, 0, 0.1);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8A00, #FFB366);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-fill.warning {
  background: linear-gradient(90deg, #FF4444, #FF6666);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  bottom: 60rpx;
  right: 60rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8A00, #FFB366);
  color: #FFFBF0;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 50rpx rgba(255, 138, 0, 0.3);
  z-index: 1000;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999999;
}

.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

/* 响应式容器 */
.container {
  padding: 0 40rpx;
  min-height: 100vh;
}

/* 工具类 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.hidden {
  display: none;
}
