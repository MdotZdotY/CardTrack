<!--pages/settings/settings.wxml-->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <view class="user-avatar">
      <text class="avatar-text">卡</text>
    </view>
    <view class="user-info">
      <text class="user-name">卡点用户</text>
      <text class="user-desc">让每一次消费都有记录</text>
    </view>
  </view>
  
  <!-- 统计信息区域 -->
  <view class="stats-section">
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-number">{{statistics.totalCards}}</text>
        <text class="stat-label">总卡片</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{statistics.activeCards}}</text>
        <text class="stat-label">使用中</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{statistics.expiringCards}}</text>
        <text class="stat-label">即将到期</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{statistics.totalRemainingCount}}</text>
        <text class="stat-label">剩余次数</text>
      </view>
    </view>
  </view>
  
  <!-- 功能设置区域 -->
  <view class="settings-section">
    <view class="section-title">功能设置</view>
    
    <view class="setting-item" bindtap="setReminder">
      <view class="setting-info">
        <text class="setting-icon">🔔</text>
        <text class="setting-label">提醒设置</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item" bindtap="backupData">
      <view class="setting-info">
        <text class="setting-icon">💾</text>
        <text class="setting-label">数据备份</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item" bindtap="restoreData">
      <view class="setting-info">
        <text class="setting-icon">📥</text>
        <text class="setting-label">数据恢复</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item" bindtap="exportData">
      <view class="setting-info">
        <text class="setting-icon">📤</text>
        <text class="setting-label">导出数据</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
  </view>
  
  <!-- 应用信息区域 -->
  <view class="settings-section">
    <view class="section-title">应用信息</view>
    
    <view class="setting-item" bindtap="viewAbout">
      <view class="setting-info">
        <text class="setting-icon">ℹ️</text>
        <text class="setting-label">关于卡点</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item" bindtap="viewHelp">
      <view class="setting-info">
        <text class="setting-icon">❓</text>
        <text class="setting-label">使用帮助</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item" bindtap="viewFeedback">
      <view class="setting-info">
        <text class="setting-icon">💬</text>
        <text class="setting-label">意见反馈</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-icon">📱</text>
        <text class="setting-label">版本信息</text>
      </view>
      <text class="setting-value">v1.0.0</text>
    </view>
  </view>
  
  <!-- 数据管理区域 -->
  <view class="settings-section">
    <view class="section-title">数据管理</view>
    
    <view class="setting-item" bindtap="clearData">
      <view class="setting-info">
        <text class="setting-icon">🗑️</text>
        <text class="setting-label">清空数据</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
    
    <view class="setting-item" bindtap="resetApp">
      <view class="setting-info">
        <text class="setting-icon">🔄</text>
        <text class="setting-label">重置应用</text>
      </view>
      <text class="setting-arrow">></text>
    </view>
  </view>
  
  <!-- 分享区域 -->
  <view class="share-section">
    <button class="btn btn-primary share-btn" bindtap="shareApp">
      分享给朋友
    </button>
  </view>
</view>
