<!--pages/index/index.wxml-->
<view class="container">
  <!-- 头部区域 -->
  <view class="header">
    <view class="header-top">
      <view class="logo-section">
        <text class="logo-title">卡点时光</text>
        <text class="logo-subtitle">榨干每一张消费卡的"剩余价值"</text>
      </view>
      <view class="search-icon" bindtap="showSearch">
        <text class="iconfont icon-search"></text>
      </view>
    </view>
    
    <!-- 统计卡片 -->
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-number">{{totalCards}}</text>
        <text class="stat-label">总卡片</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{expiringSoon}}</text>
        <text class="stat-label">即将到期</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{runningOut}}</text>
        <text class="stat-label">即将用完</text>
      </view>
    </view>
    
  </view>
  
  <!-- 卡片列表区 -->
  <view class="cards-section">
    <!-- 卡片列表 -->
    <view class="cards-list" wx:if="{{filteredCards.length > 0}}">
      <view class="card-item {{item.isUsedUp || item.isExpired ? 'used-up' : ''}}" wx:for="{{filteredCards}}" wx:key="id" bindtap="editCard" data-id="{{item.id}}">
        <view class="card-header">
          <view class="card-title">
            <text class="card-name">{{item.name}}</text>
            <text class="card-merchant">{{item.merchant}}</text>
          </view>
          <view class="card-category">
            <text class="reminder-icon" wx:if="{{item.isExpiring || item.isRunningOut}}">💡</text>
            <text class="category-text">{{item.category}}</text>
          </view>
        </view>
        
        <view class="card-content">
          <view class="usage-info">
            <text class="usage-text">
              <text wx:if="{{item.isUnlimited}}">{{item.unitPriceText}}</text>
              <text wx:else>{{item.unitPriceText}}</text>
            </text>
          </view>
          
          <view class="card-actions" catchtap="stopPropagation">
            <view class="button-group-left">
              <button class="btn btn-detail" size="mini" bindtap="showCardDetail" data-id="{{item.id}}">
                详情
              </button>
              <button class="btn btn-primary" size="mini" bindtap="recordUsage" data-id="{{item.id}}" wx:if="{{item.canUse}}">
                记录使用
              </button>
            </view>
            <view class="button-group-right">
              <button class="btn btn-share" size="mini" bindtap="shareCard" data-id="{{item.id}}" wx:if="{{!item.canUse}}">
                分享
              </button>
            </view>
          </view>
          
          <!-- 使用次数进度条 - 仅对有限次数卡片显示，放在按钮下方 -->
          <view class="usage-progress-container" wx:if="{{!item.isUnlimited}}">
            <view class="usage-progress-bar">
              <view class="usage-progress-fill" style="width: {{item.progress}}%"></view>
            </view>
            <view class="usage-progress-info">
              <text class="usage-progress-text">还有{{item.totalCount - item.usedCount}}次用完</text>
              <text class="usage-progress-percent">{{item.progressFixed}}%</text>
            </view>
          </view>
        </view>
        
        <view class="card-footer" wx:if="{{item.expireDate}}">
          <!-- 日期进度条 -->
          <view class="date-progress-container">
            <view class="date-progress-bar">
              <view class="date-progress-fill" style="width: {{item.dateProgress}}%"></view>
            </view>
            <view class="date-progress-info">
              <text class="date-progress-text">{{item.dateProgressText}}</text>
              <text class="date-progress-percent">{{item.dateProgressFixed}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredCards.length === 0}}">
      <text class="empty-icon">📱</text>
      <text class="empty-text">暂无套餐卡</text>
      <text class="empty-hint">点击底部导航栏的"+"按钮添加您的第一张套餐卡</text>
    </view>
  </view>

  
  <!-- 记录使用弹窗 -->
  <view class="modal-overlay" wx:if="{{showRecordModal}}" bindtap="closeRecordModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">记录使用</text>
        <text class="modal-close" bindtap="closeRecordModal">×</text>
      </view>
      
      <view class="modal-body">
        <!-- 使用时间选择 -->
        <view class="form-item">
          <text class="form-label">使用时间 *</text>
          <view class="form-picker" bindtap="showRecordDatePicker">
            <view class="picker-text">
              {{recordForm.useDate || '请选择使用时间'}}
            </view>
            <text class="picker-arrow">▼</text>
          </view>
        </view>
        
        <!-- 日期选择器 - 嵌入在弹窗中 -->
        <view class="inline-date-picker" wx:if="{{showRecordDatePicker}}">
          <view class="date-picker-header">
            <text class="date-picker-cancel" bindtap="hideRecordDatePicker">取消</text>
            <text class="date-picker-title">选择使用时间</text>
            <text class="date-picker-confirm" bindtap="confirmRecordDateSelection">确定</text>
          </view>
          
          <view class="date-picker-content">
            <picker-view class="date-picker-view" 
                         value="{{recordDatePickerValue}}" 
                         bindchange="onRecordDatePickerChange">
              <picker-view-column>
                <view wx:for="{{recordYears}}" wx:key="index" class="date-picker-item">{{item}}年</view>
              </picker-view-column>
              <picker-view-column>
                <view wx:for="{{recordMonths}}" wx:key="index" class="date-picker-item">{{item}}月</view>
              </picker-view-column>
              <picker-view-column>
                <view wx:for="{{recordDays}}" wx:key="index" class="date-picker-item">{{item}}日</view>
              </picker-view-column>
            </picker-view>
          </view>
        </view>
        
        <!-- 使用次数输入 -->
        <view class="form-item">
          <text class="form-label">使用次数 *</text>
          <input class="form-input" 
                 type="number"
                 name="useCount" 
                 value="{{recordForm.useCount}}"
                 placeholder="请输入使用次数"
                 bindinput="onUseCountInput"
                 data-field="useCount" />
        </view>
        
        <!-- 卡片信息显示 -->
        <view class="card-info-display" wx:if="{{selectedCard}}">
          <text class="info-label">当前卡片：</text>
          <text class="info-text">{{selectedCard.name}} - {{selectedCard.merchant}}</text>
          <text class="info-label">剩余次数：</text>
          <text class="info-text">
            <text wx:if="{{selectedCard.isUnlimited}}">不限</text>
            <text wx:else>{{selectedCard.totalCount - selectedCard.usedCount}} / {{selectedCard.totalCount}}</text>
          </text>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn btn-secondary" bindtap="closeRecordModal">取消</button>
        <button class="btn btn-primary" bindtap="confirmRecordUsage" disabled="{{!isRecordFormValid}}">
          确认记录
        </button>
      </view>
      
    </view>
  </view>
  
  <!-- 卡片详情月历弹窗 -->
  <view class="modal-overlay" wx:if="{{showDetailModal}}" bindtap="closeDetailModal">
    <view class="modal-content detail-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{selectedCardDetail.name}} - 使用记录</text>
        <text class="modal-close" bindtap="closeDetailModal">×</text>
      </view>
      
      <view class="modal-body">
        <!-- 月份切换 -->
        <view class="calendar-header">
          <text class="month-nav-btn" bindtap="prevMonth">‹</text>
          <text class="current-month">{{currentYear}}年{{currentMonth}}月</text>
          <text class="month-nav-btn" bindtap="nextMonth">›</text>
        </view>
        
        <!-- 月历 -->
        <view class="calendar-container">
          <!-- 星期标题 -->
          <view class="calendar-weekdays">
            <text class="weekday" wx:for="{{weekdays}}" wx:key="index">{{item}}</text>
          </view>
          
          <!-- 日期网格 -->
          <view class="calendar-grid">
            <view class="calendar-day {{item.isOtherMonth ? 'other-month' : ''}} {{item.isUsed ? 'used-day' : ''}} {{item.isToday ? 'today' : ''}} {{item.isEditing ? 'editing' : ''}}" 
                  wx:for="{{calendarDays}}" 
                  wx:key="date"
                  bindtap="toggleDayUsage"
                  bindlongpress="increaseDayUsage"
                  data-date="{{item.date}}"
                  data-is-used="{{item.isUsed ? 'true' : 'false'}}"
                  data-usage-count="{{item.usageCount}}">
              <text class="day-number">{{item.day}}</text>
              <text class="usage-count" wx:if="{{item.usageCount > 0}}">{{item.usageCount}}</text>
            </view>
          </view>
        </view>
        
        <!-- 使用统计 -->
        <view class="usage-stats" wx:if="{{selectedCardDetail}}">
          <view class="stat-row">
            <text class="stat-label">本月使用次数：</text>
            <text class="stat-value">{{monthlyUsageCount}}次</text>
          </view>
          <view class="stat-row">
            <text class="stat-label">总使用次数：</text>
            <text class="stat-value">{{selectedCardDetail.usedCount}}次</text>
          </view>
        </view>
        
        <!-- 编辑模式按钮 -->
        <view class="edit-actions" wx:if="{{isEditingMode}}">
          <button class="btn btn-cancel" bindtap="cancelEdit">取消</button>
          <button class="btn btn-save" bindtap="saveEdit">保存</button>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 自定义底部导航栏 -->
  <custom-tabbar current-tab="{{0}}"></custom-tabbar>
  
  <!-- 隐藏的canvas用于生成分享图片 -->
  <canvas canvas-id="shareCanvas" style="position: fixed; top: -9999px; left: -9999px; width: 750px; height: 1334px;"></canvas>
</view>
