<!--components/custom-tabbar/custom-tabbar.wxml-->
<view class="custom-tabbar">
  <view class="tabbar-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0" data-path="/pages/index/index">
    <text class="tabbar-text">首页</text>
  </view>
  <view class="tabbar-item add-button" bindtap="addCard">
    <text class="add-icon">+</text>
  </view>
  <view class="tabbar-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1" data-path="/pages/stats/stats">
    <text class="tabbar-text">统计</text>
  </view>
</view>

