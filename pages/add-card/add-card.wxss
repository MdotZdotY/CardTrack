/* pages/add-card/add-card.wxss */
.container {
  padding: 0;
  min-height: 100vh;
  background: #FFFBF0;
}

.form-container {
  padding: 40rpx;
}

.form-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.form-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #020100;
  display: block;
  margin-bottom: 16rpx;
}

.form-subtitle {
  font-size: 28rpx;
  color: #666666;
  display: block;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #020100;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 251, 240, 0.8);
  border: 2rpx solid rgba(255, 138, 0, 0.2);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #020100;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #FF8A00;
  background: rgba(255, 251, 240, 1);
}

.form-picker {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 251, 240, 0.8);
  border: 2rpx solid rgba(255, 138, 0, 0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.picker-text {
  font-size: 28rpx;
  color: #020100;
  flex: 1;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: rgba(255, 251, 240, 0.8);
  border: 2rpx solid rgba(255, 138, 0, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #020100;
  box-sizing: border-box;
  resize: none;
}

.form-textarea:focus {
  border-color: #FF8A00;
  background: rgba(255, 251, 240, 1);
}

.textarea-counter {
  font-size: 24rpx;
  color: #999999;
  text-align: right;
  margin-top: 8rpx;
  display: block;
}

.form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 60rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #FF8A00 0%, #FFB366 100%);
  color: #FFFBF0;
}

.btn-primary:disabled {
  background: #CCCCCC;
  color: #999999;
}

.btn-secondary {
  background: rgba(255, 138, 0, 0.1);
  color: #FF8A00;
  border: 2rpx solid rgba(255, 138, 0, 0.2);
}

.btn:active {
  transform: scale(0.98);
}

/* 输入框占位符样式 */
.form-input::placeholder,
.form-textarea::placeholder {
  color: #999999;
}

/* 数字输入框样式 */
.form-input[type="number"] {
  text-align: right;
}
