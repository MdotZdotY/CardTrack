/* pages/stats/stats.wxss */
.container {
  padding: 0;
  height: 100vh;
  background: #FFF2DF;
  display: flex;
  flex-direction: column;
}

.safe-top { height: calc(env(safe-area-inset-top) + 44px); }

/* 页面标题 - 固定定位 */
.page-header {
  background: linear-gradient(135deg, #FCC96E 0%, #FDD89A 100%);
  color: #156D57;
  text-align: center;
  padding: 88rpx 40rpx 40rpx;
  padding-top: calc(env(safe-area-inset-top) + 44px);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.page-header .safe-top { display: none; }

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #156D57;
  margin-bottom: 16rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #156D57;
  opacity: 0.8;
}

/* 统计概览 - 固定定位 */
.stats-overview {
  display: flex;
  justify-content: space-between;
  margin: 0 40rpx 40rpx;
  padding-top: calc(env(safe-area-inset-top) + 44px + 88rpx + 40rpx + 60rpx + 80rpx);
  flex-shrink: 0;
}

/* 分类统计区域 - 可滚动 */
.category-section {
  flex: 1;
  padding: 0 40rpx;
  background: #FFF2DF;
  overflow-y: auto;
  /* 为固定头部和统计概览留出空间 */
  padding-top: 20rpx;
  /* 为底部导航栏留出空间 */
  padding-bottom: 140rpx;
  /* 滚动优化 */
  -webkit-overflow-scrolling: touch;
}

.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  margin: 0 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.stat-card:first-child {
  margin-left: 0;
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #156D57;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 分类统计 */
.category-stats {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #020100;
  margin-bottom: 24rpx;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.category-item:last-child {
  border-bottom: none;
}

.category-info {
  flex: 1;
}

.category-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.category-count {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.category-progress {
  display: flex;
  align-items: center;
  width: 200rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FCC96E, #FDD89A);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  min-width: 60rpx;
  text-align: right;
}


/* 到期提醒 */
.expiry-reminder {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.expiry-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.expiry-item:last-child {
  border-bottom: none;
}

.expiry-info {
  text-align: right;
}

.days-left {
  display: block;
  font-size: 28rpx;
  color: #156D57;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.remaining-count {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-hint {
  display: block;
  font-size: 28rpx;
  color: #666;
}
