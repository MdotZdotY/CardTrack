<!--pages/settings/settings.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">设置</text>
    <text class="page-subtitle">个性化您的使用体验</text>
  </view>

  <!-- 功能设置 -->
  <view class="settings-section">
    <view class="section-title">功能设置</view>
    
    <view class="setting-item" bindtap="goToReminderSettings">
      <view class="setting-left">
        <text class="setting-icon">🔔</text>
        <view class="setting-info">
          <text class="setting-title">提醒设置</text>
          <text class="setting-desc">设置到期提醒和使用频率提醒</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="settings-section">
    <view class="section-title">数据管理</view>
    
    <view class="setting-item" bindtap="backupData">
      <view class="setting-left">
        <text class="setting-icon">💾</text>
        <view class="setting-info">
          <text class="setting-title">创建备份</text>
          <text class="setting-desc">备份当前所有数据</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="restoreData">
      <view class="setting-left">
        <text class="setting-icon">📥</text>
        <view class="setting-info">
          <text class="setting-title">恢复数据</text>
          <text class="setting-desc">从备份恢复数据</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="viewBackupList">
      <view class="setting-left">
        <text class="setting-icon">📋</text>
        <view class="setting-info">
          <text class="setting-title">备份列表</text>
          <text class="setting-desc">查看所有备份信息</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="exportData">
      <view class="setting-left">
        <text class="setting-icon">📤</text>
        <view class="setting-info">
          <text class="setting-title">导出数据</text>
          <text class="setting-desc">导出您的套餐卡数据</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="importData">
      <view class="setting-left">
        <text class="setting-icon">📥</text>
        <view class="setting-info">
          <text class="setting-title">导入数据</text>
          <text class="setting-desc">从备份文件导入数据</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="optimizeStorage">
      <view class="setting-left">
        <text class="setting-icon">🔧</text>
        <view class="setting-info">
          <text class="setting-title">优化存储</text>
          <text class="setting-desc">清理重复备份，压缩旧备份</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="clearData">
      <view class="setting-left">
        <text class="setting-icon">🗑️</text>
        <view class="setting-info">
          <text class="setting-title">清空数据</text>
          <text class="setting-desc">删除所有套餐卡数据</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="resetApp">
      <view class="setting-left">
        <text class="setting-icon">🔄</text>
        <view class="setting-info">
          <text class="setting-title">重置应用</text>
          <text class="setting-desc">恢复默认设置</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>
  </view>

  <!-- 关于应用 -->
  <view class="settings-section">
    <view class="section-title">关于应用</view>
    
    <view class="setting-item" bindtap="showAbout">
      <view class="setting-left">
        <text class="setting-icon">ℹ️</text>
        <view class="setting-info">
          <text class="setting-title">关于卡点时光</text>
          <text class="setting-desc">版本信息和使用说明</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="showFeedback">
      <view class="setting-left">
        <text class="setting-icon">💬</text>
        <view class="setting-info">
          <text class="setting-title">意见反馈</text>
          <text class="setting-desc">告诉我们您的建议</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="showShare">
      <view class="setting-left">
        <text class="setting-icon">📤</text>
        <view class="setting-info">
          <text class="setting-title">分享应用</text>
          <text class="setting-desc">推荐给朋友使用</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">卡点时光 v1.0.0</text>
    <text class="copyright">© 2024 卡点时光团队</text>
  </view>
  
  <!-- 自定义底部导航栏 -->
  <custom-tabbar current-tab="{{2}}"></custom-tabbar>
</view>
