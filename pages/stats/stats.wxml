<!--pages/stats/stats.wxml-->
<view class="container">
  <!-- 页面标题（与首页一致的顶铺样式） -->
  <view class="page-header" style="{{headerStyle}}">
    <text class="page-title">使用统计</text>
    <text class="page-subtitle">让每一分钱都"死得其所"</text>
  </view>

  <view class="page-content">
  <!-- 统计概览 -->
  <view class="stats-overview">
    <view class="stat-card">
      <text class="stat-number">{{effectiveCards}} / {{totalCards}}</text>
      <text class="stat-label">有效卡 / 总卡片</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{expiredCards}} / {{usedUpCards}}</text>
      <text class="stat-label">已过期 / 已用完</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{totalValue}}</text>
      <text class="stat-label">总价值(万元)</text>
    </view>
  </view>

  <!-- 分类统计 -->
  <view class="category-stats">
    <text class="section-title">分类统计</text>
    <view class="category-list">
      <view class="category-item" wx:for="{{categoryStats}}" wx:key="category">
        <view class="category-info">
          <text class="category-name">{{item.category}}</text>
          <text class="category-count">{{item.count}}张</text>
        </view>
        <view class="category-progress">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{item.percentage}}%"></view>
          </view>
          <text class="progress-text">{{item.percentage}}%</text>
        </view>
      </view>
    </view>
  </view>
  </view>
  

  <!-- 到期提醒（按需隐藏，不在统计页展示列表） -->
  <!--
  <view class="expiry-reminder" wx:if="{{expiringCards.length > 0}}">
    <text class="section-title">即将到期</text>
    <view class="expiry-list">
      <view class="expiry-item" wx:for="{{expiringCards}}" wx:key="id">
        <view class="card-info">
          <text class="card-name">{{item.name}}</text>
          <text class="merchant-name">{{item.merchant}}</text>
        </view>
        <view class="expiry-info">
          <text class="days-left">还有{{item.daysLeft}}天到期</text>
          <text class="remaining-count">剩余{{item.remainingCount}}次</text>
        </view>
      </view>
    </view>
  </view>
  -->

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{totalCards === 0}}">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无统计数据</text>
    <text class="empty-hint">添加套餐卡后即可查看详细统计</text>
  </view>
  
  <!-- 自定义底部导航栏 -->
  <custom-tabbar current-tab="{{1}}"></custom-tabbar>
</view>
