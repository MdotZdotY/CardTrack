/* pages/settings/settings.wxss */
.container {
  padding: 0;
  min-height: 100vh;
  background: #FFF2DF;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #FCC96E 0%, #FDD89A 100%);
  padding: 60rpx 40rpx 40rpx;
  color: #156D57;
  text-align: center;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #156D57;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  color: #156D57;
}

/* 用户信息区域 */
.user-section {
  background: linear-gradient(135deg, #FCC96E 0%, #FDD89A 100%);
  padding: 60rpx 40rpx;
  color: #156D57;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(21, 109, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  border: 4rpx solid rgba(21, 109, 87, 0.3);
}

.avatar-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #156D57;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.user-desc {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
}

/* 统计信息区域 */
.stats-section {
  padding: 40rpx;
  background: #FFF2DF;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.stat-item {
  text-align: center;
  padding: 24rpx 16rpx;
  background: rgba(255, 242, 223, 0.8);
  border-radius: 16rpx;
  border: 2rpx solid rgba(252, 201, 110, 0.1);
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #FCC96E;
  margin-bottom: 8rpx;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
  display: block;
}

/* 设置区域 */
.settings-section {
  margin-bottom: 24rpx;
  background: #FFF2DF;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #020100;
  padding: 32rpx 40rpx 16rpx;
  display: block;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid rgba(252, 201, 110, 0.1);
  background: #FFF2DF;
  transition: all 0.3s ease;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: rgba(252, 201, 110, 0.05);
}

.setting-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.setting-icon {
  font-size: 32rpx;
  margin-right: 24rpx;
  width: 40rpx;
  text-align: center;
}

.setting-label {
  font-size: 28rpx;
  color: #020100;
}

.setting-arrow {
  font-size: 24rpx;
  color: #999999;
}

.setting-value {
  font-size: 26rpx;
  color: #666666;
}

/* 分享区域 */
.share-section {
  padding: 40rpx;
  background: #FFF2DF;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  background: linear-gradient(135deg, #FCC96E 0%, #FDD89A 100%);
  color: #156D57;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.share-btn:active {
  transform: scale(0.98);
}
