/* pages/card-detail/card-detail.wxss */
.container {
  padding: 0;
  min-height: 100vh;
  background: #FFFBF0;
}

/* 卡片信息区域 */
.card-info-section {
  background: linear-gradient(135deg, #FF8A00 0%, #FFB366 100%);
  padding: 40rpx;
  color: #FFFBF0;
}

.card-header {
  margin-bottom: 40rpx;
}

.card-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.card-merchant {
  font-size: 32rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
  display: block;
}

.card-category {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  background: rgba(255, 251, 240, 0.2);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 251, 240, 0.3);
}

.card-progress-section {
  margin-bottom: 32rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.usage-text {
  font-size: 28rpx;
  font-weight: 500;
}

.remaining-text {
  font-size: 28rpx;
  font-weight: 500;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 251, 240, 0.2);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: rgba(255, 251, 240, 0.8);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-fill.warning {
  background: #FF4444;
}

.card-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-text {
  font-size: 26rpx;
  font-weight: 500;
}

.status-text.normal {
  color: #4CAF50;
}

.status-text.warning {
  color: #FF8A00;
}

.status-text.expired {
  color: #FF4444;
}

.expire-text {
  font-size: 24rpx;
  opacity: 0.8;
}

.expire-text.expire-warning {
  color: #FF4444;
  font-weight: bold;
}

/* 操作按钮区域 */
.action-section {
  padding: 40rpx;
  background: #FFFBF0;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #FF8A00 0%, #FFB366 100%);
  color: #FFFBF0;
}

.btn-primary:disabled {
  background: #CCCCCC;
  color: #999999;
}

.btn-secondary {
  background: rgba(255, 138, 0, 0.1);
  color: #FF8A00;
  border: 2rpx solid rgba(255, 138, 0, 0.2);
}

.btn-secondary:disabled {
  background: #F5F5F5;
  color: #CCCCCC;
  border-color: #E0E0E0;
}

.btn:active {
  transform: scale(0.98);
}

.quick-actions {
  display: flex;
  justify-content: space-around;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  background: rgba(255, 138, 0, 0.1);
  transform: scale(0.95);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.action-label {
  font-size: 24rpx;
  color: #666666;
}

/* 详细信息区域 */
.detail-section {
  padding: 40rpx;
  background: #FFFBF0;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #020100;
  margin-bottom: 32rpx;
  display: block;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 138, 0, 0.1);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #666666;
  flex: 1;
}

.detail-value {
  font-size: 28rpx;
  color: #020100;
  text-align: right;
  flex: 1;
}

.detail-value.expire-warning {
  color: #FF4444;
  font-weight: bold;
}

/* 使用记录区域 */
.usage-section {
  padding: 40rpx;
  background: #FFFBF0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.record-count {
  font-size: 24rpx;
  color: #999999;
}

.empty-records {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999999;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.usage-record {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 138, 0, 0.1);
}

.usage-record:last-child {
  border-bottom: none;
}

.record-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 28rpx;
  color: #020100;
  font-weight: 500;
}

.record-relative {
  font-size: 24rpx;
  color: #999999;
}

.record-notes {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}
