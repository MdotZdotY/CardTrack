<!--pages/index/index.wxml-->
<view class="container">
  <!-- 头部区域 -->
  <view class="header">
    <view class="header-top">
      <view class="logo-section">
        <text class="logo-title">卡点时光</text>
        <text class="logo-subtitle">让每一次消费都有记录</text>
      </view>
      <view class="search-icon" bindtap="showSearch">
        <text class="iconfont icon-search"></text>
      </view>
    </view>
    
    <!-- 统计卡片 -->
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-number">{{totalCards}}</text>
        <text class="stat-label">总卡片</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{expiringSoon}}</text>
        <text class="stat-label">即将到期</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{remainingCount}}</text>
        <text class="stat-label">剩余次数</text>
      </view>
    </view>
  </view>
  
  <!-- 卡片列表区 -->
  <view class="cards-section">
    <!-- 筛选标签 -->
    <view class="filter-tabs">
      <view class="filter-tab {{currentFilter === 'all' ? 'active' : ''}}" bindtap="filterCards" data-filter="all">
        <text>全部</text>
      </view>
      <view class="filter-tab {{currentFilter === 'expiring' ? 'active' : ''}}" bindtap="filterCards" data-filter="expiring">
        <text>即将到期</text>
      </view>
      <view class="filter-tab {{currentFilter === 'active' ? 'active' : ''}}" bindtap="filterCards" data-filter="active">
        <text>使用中</text>
      </view>
    </view>

    <!-- 卡片列表 -->
    <view class="cards-list" wx:if="{{filteredCards.length > 0}}">
      <view class="card-item" wx:for="{{filteredCards}}" wx:key="id">
        <view class="card-header">
          <view class="card-title">
            <text class="card-name">{{item.name}}</text>
            <text class="card-merchant">{{item.merchant}}</text>
          </view>
          <view class="card-category">{{item.category}}</view>
        </view>
        
        <view class="card-content">
          <view class="usage-info">
            <text class="usage-text">已使用 {{item.usedCount}} / {{item.totalCount}} 次</text>
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{item.progress}}%"></view>
            </view>
          </view>
          
          <view class="card-actions">
            <button class="btn btn-primary" bindtap="recordUsage" data-id="{{item.id}}" wx:if="{{item.canUse}}">
              记录使用
            </button>
            <button class="btn btn-secondary" bindtap="viewDetail" data-id="{{item.id}}">
              详情
            </button>
          </view>
        </view>
        
        <view class="card-footer" wx:if="{{item.expireDate}}">
          <text class="expire-text {{item.isExpiring ? 'expiring' : ''}}">{{item.expireText}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredCards.length === 0}}">
      <text class="empty-icon">📱</text>
      <text class="empty-text">暂无套餐卡</text>
      <text class="empty-hint">点击下方"+"按钮添加您的第一张套餐卡</text>
    </view>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="addCard">+</view>
  
  <!-- 自定义底部导航栏 -->
  <custom-tabbar current-tab="{{0}}"></custom-tabbar>
</view>
